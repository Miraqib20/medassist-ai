# Environment Variables Configuration for MediAssist AI

# App settings
APP_NAME="MediAssist AI"
ENVIRONMENT=development
DEBUG=True

# Backend Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Security & Authentication
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=mediassist_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# By default, uses SQLite for zero-setup local dev/test. Set to PostgreSQL URI for production.
# SQLite format: sqlite:///./mediassist.db
# PostgreSQL format: postgresql://postgres:postgres@localhost:5432/mediassist_db
DATABASE_URL=sqlite:///./mediassist.db

# AI & LLM Settings
# Supported providers: gemini, openai, anthropic, or local_fallback
AI_PROVIDER=local_fallback
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# RAG Settings
RAG_TOP_K=3
SIMILARITY_THRESHOLD=0.3
